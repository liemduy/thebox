{
  "name": "liems-planner",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "node scripts/build-js.mjs",
    "build:css": "tailwindcss -i src/styles.css -o assets/styles.css --content index.html --content src/**/*.jsx --minify",
    "test": "node test/core.test.cjs",
    "verify": "npm run test && npm run build && node --check assets/app.js && node --check scripts/build-js.mjs"
  },
  "devDependencies": {
    "@babel/core": "7.26.10",
    "@babel/preset-react": "7.26.3",
    "tailwindcss": "3.4.17"
  }
}
