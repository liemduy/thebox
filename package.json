{
  "name": "liems-planner",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "node scripts/build-js.mjs",
    "build:css": "tailwindcss -i src/styles.css -o assets/styles.css --minify",
    "test": "node test/core.test.cjs && node test/integrity.test.cjs && node test/migrations.test.cjs && node test/sync.test.cjs && node test/source-smoke.test.cjs",
    "test:browser": "playwright test test/browser-smoke.test.cjs --reporter=line",
    "verify": "npm run test && npm run build && node --check assets/app.js && node --check scripts/build-js.mjs"
  },
  "devDependencies": {
    "@babel/core": "7.26.10",
    "@babel/preset-react": "7.26.3",
    "@playwright/test": "1.60.0",
    "esbuild": "0.25.5",
    "prosemirror-commands": "1.7.1",
    "prosemirror-history": "1.4.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.1",
    "prosemirror-schema-basic": "1.2.4",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.3",
    "prosemirror-view": "1.40.0",
    "tailwindcss": "3.4.17"
  }
}
